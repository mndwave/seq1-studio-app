<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Match AppLoader bg so bars are correct colour from first frame -->
        <item name="android:statusBarColor">#0c0a09</item>
        <item name="android:navigationBarColor">#0c0a09</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Set bar colours at OS level — before any JS runs, prevents grey flash -->
        <item name="android:statusBarColor">#0c0a09</item>
        <item name="android:navigationBarColor">#0c0a09</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- STUDIO-NO-ACTIONBAR-GAP-2026-05-25 (Kyle screenshot — black gap above header):
             Without postSplashScreenTheme, Android keeps Theme.SplashScreen active
             after splash dismisses. That parent ultimately resolves through
             AppCompat which reserves layout space for an ActionBar even when hidden,
             leaving a dark strip between system status bar and the web header.
             Switching to NoActionBar after splash reclaims that space. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
